#--------------------------------------------------------------------
# PRODUCTION Environment Configuration
# For: dashboard.africawatersolutions.org
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------

CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

app.baseURL = 'http://dashboard.africawatersolutions.org/'
app.forceGlobalSecureRequests = false
app.indexPage = ''

# Session Configuration
app.sessionDriver = 'CodeIgniter\Session\Handlers\FileHandler'
app.sessionCookieName = 'aws_session'
app.sessionExpiration = 7200
app.sessionSavePath = null
app.sessionMatchIP = false
app.sessionTimeToUpdate = 300
app.sessionRegenerateDestroy = false

# Cookie Security Settings
app.cookiePrefix = ''
app.cookieDomain = '.africawatersolutions.org'
app.cookiePath = '/'
app.cookieSecure = false  # Set to true if you enable HTTPS
app.cookieHTTPOnly = true
app.cookieSameSite = 'Lax'

# CSRF Protection (ENABLED for security)
app.CSRFProtection = true
app.CSRFTokenName = 'csrf_test_name'
app.CSRFCookieName = 'csrf_cookie_name'
app.CSRFExpire = 7200
app.CSRFRegenerate = true
app.CSRFExcludeURIs = []
app.CSRFSameSite = 'Lax'

# Content Security Policy
app.CSPEnabled = false

#--------------------------------------------------------------------
# DATABASE - UPDATE WITH YOUR PRODUCTION DATABASE CREDENTIALS
#--------------------------------------------------------------------

database.default.hostname = localhost
database.default.database = YOUR_PRODUCTION_DB_NAME
database.default.username = YOUR_PRODUCTION_DB_USER
database.default.password = YOUR_PRODUCTION_DB_PASSWORD
database.default.DBDriver = MySQLi

#--------------------------------------------------------------------
# SECURITY
#--------------------------------------------------------------------

security.tokenName = 'csrf_token_name'
security.headerName = 'X-CSRF-TOKEN'
security.cookieName = 'csrf_cookie_name'
security.expires = 7200
security.regenerate = true
security.redirect = true
security.samesite = 'Lax'

#--------------------------------------------------------------------
# LOGGER
#--------------------------------------------------------------------

logger.threshold = 1  # Only log errors in production

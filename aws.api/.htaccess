<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /aws_staging/aws.api/
    
    # Handle preflight OPTIONS requests
    RewriteCond %{REQUEST_METHOD} OPTIONS
    RewriteRule ^(.*)$ $1 [R=200,L]
    
    # Don't redirect if we're already in the public folder
    RewriteCond %{REQUEST_URI} !^/aws_staging/aws\.api/public/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<IfModule !mod_rewrite.c>
    ErrorDocument 404 /aws_staging/aws.api/public/index.php
</IfModule>
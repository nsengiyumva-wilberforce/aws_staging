#--------------------------------------------------------------------
# DEVELOPMENT Environment Configuration  
# For: dev.impact-outsourcing.com
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

app.baseURL = 'https://dev.impact-outsourcing.com/'
app.forceGlobalSecureRequests = true  # Force HTTPS for dev server
app.indexPage = ''

# Session Configuration
app.sessionDriver = 'CodeIgniter\Session\Handlers\FileHandler'
app.sessionCookieName = 'aws_dev_session'
app.sessionExpiration = 7200
app.sessionSavePath = null
app.sessionMatchIP = false
app.sessionTimeToUpdate = 300
app.sessionRegenerateDestroy = false

# Cookie Security Settings
app.cookiePrefix = ''
app.cookieDomain = '.impact-outsourcing.com'
app.cookiePath = '/'
app.cookieSecure = true   # HTTPS is available on dev server
app.cookieHTTPOnly = true
app.cookieSameSite = 'Lax'

# CSRF Protection (ENABLED for security)
app.CSRFProtection = true
app.CSRFTokenName = 'csrf_test_name'
app.CSRFCookieName = 'csrf_cookie_name'
app.CSRFExpire = 7200
app.CSRFRegenerate = true
app.CSRFExcludeURIs = []
app.CSRFSameSite = 'Lax'

# Content Security Policy
app.CSPEnabled = false

#--------------------------------------------------------------------
# DATABASE - UPDATE WITH YOUR DEVELOPMENT DATABASE CREDENTIALS
#--------------------------------------------------------------------

database.default.hostname = localhost
database.default.database = YOUR_DEV_DB_NAME
database.default.username = YOUR_DEV_DB_USER
database.default.password = YOUR_DEV_DB_PASSWORD
database.default.DBDriver = MySQLi

#--------------------------------------------------------------------
# SECURITY
#--------------------------------------------------------------------

security.tokenName = 'csrf_token_name'
security.headerName = 'X-CSRF-TOKEN'
security.cookieName = 'csrf_cookie_name'
security.expires = 7200
security.regenerate = true
security.redirect = true
security.samesite = 'Lax'

#--------------------------------------------------------------------
# LOGGER
#--------------------------------------------------------------------

logger.threshold = 4  # More verbose logging in development
